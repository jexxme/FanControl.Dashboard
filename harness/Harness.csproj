<Project Sdk="Microsoft.NET.Sdk">
  <!-- Stand-alone host that renders the dashboard view to PNG files without a Fan Control window. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Harness</AssemblyName>
    <RootNamespace>Harness</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\FanControl.Dashboard.csproj" />
  </ItemGroup>
</Project>
