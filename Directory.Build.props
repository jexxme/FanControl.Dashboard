<Project>
  <!--
    Shared build settings.

    Fan Control's assemblies (FanControl.Plugins, FanControl.IPC, Grpc.Core.Api, Google.Protobuf) are not
    redistributable and are not on NuGet, so they are referenced from an installed (or unzipped) Fan Control.
    Override with:  dotnet build -p:FanControlDir="D:\Apps\FanControl"
    or set the FANCONTROL_DIR environment variable.
  -->
  <PropertyGroup>
    <FanControlDir Condition="'$(FanControlDir)' == '' and '$(FANCONTROL_DIR)' != ''">$(FANCONTROL_DIR)</FanControlDir>
    <FanControlDir Condition="'$(FanControlDir)' == ''">C:\Program Files (x86)\FanControl</FanControlDir>
    <!-- separate property: a FanControlDir passed with -p: is global and cannot be modified here -->
    <FanControlRefDir>$([MSBuild]::EnsureTrailingSlash('$(FanControlDir)'))</FanControlRefDir>

    <!--
      Optional: the assemblies of Fan Control's .NET 10 build. When set, the tests and the harness are also built for
      net10.0-windows and run the net48 plugin DLL under .NET 10 against those assemblies, as Fan Control's .NET 10 build does.
      dotnet test -p:FanControlNet10Dir="C:\path	o\FanControl_net_10_0"   (or FANCONTROL_NET10_DIR)
    -->
    <FanControlNet10Dir Condition="'$(FanControlNet10Dir)' == '' and '$(FANCONTROL_NET10_DIR)' != ''">$(FANCONTROL_NET10_DIR)</FanControlNet10Dir>
    <Net10TargetFramework Condition="'$(FanControlNet10Dir)' != ''">;net10.0-windows</Net10TargetFramework>

    <Version>0.1.0</Version>
    <Authors>fancontrol-dashboard contributors</Authors>
    <Product>Fan Control Dashboard (unofficial plugin)</Product>
    <Copyright>Copyright (c) 2026 fancontrol-dashboard contributors</Copyright>

    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
