<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>FanControl.Dashboard</AssemblyName>
    <RootNamespace>FanControl.Dashboard</RootNamespace>
    <AssemblyTitle>Fan Control Dashboard plugin</AssemblyTitle>
    <Description>Unofficial Fan Control plugin: dashboard cards and history charts on the Home page.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework 4.8 assemblies (resolved from the reference assemblies package on machines without the targeting pack) -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="UIAutomationProvider" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provided by Fan Control at runtime: compile against them, never copy or ship them. -->
    <Reference Include="FanControl.Plugins"><HintPath>$(FanControlRefDir)FanControl.Plugins.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FanControl.IPC"><HintPath>$(FanControlRefDir)FanControl.IPC.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Grpc.Core.Api"><HintPath>$(FanControlRefDir)Grpc.Core.Api.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Google.Protobuf"><HintPath>$(FanControlRefDir)Google.Protobuf.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FanControl.Dashboard.Tests" />
    <InternalsVisibleTo Include="Harness" />
  </ItemGroup>

  <Target Name="CheckFanControlDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(FanControlRefDir)FanControl.Plugins.dll')"
           Text="FanControl.Plugins.dll not found in '$(FanControlDir)'. Install Fan Control V285 or pass -p:FanControlDir=&lt;folder with FanControl.exe&gt; (see README, Building)." />
  </Target>
</Project>
