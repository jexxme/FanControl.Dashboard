<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer helper: lists Fan Control's sensors and configs over its IPC (read-only, plus "load <config>"). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>FcTool</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- same binding redirects as the harness (Fan Control's dependency versions) -->
    <AppConfig>..\..\harness\App.config</AppConfig>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="FanControl.IPC"><HintPath>$(FanControlRefDir)FanControl.IPC.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Grpc.Core.Api"><HintPath>$(FanControlRefDir)Grpc.Core.Api.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Google.Protobuf"><HintPath>$(FanControlRefDir)Google.Protobuf.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
